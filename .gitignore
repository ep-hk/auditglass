# Run directories hold production-derived data. Never commit one.
# The only exception is examples/run-sample/, which is synthetic and is force-added.
runs/
*.run/

# Anything that maps pseudonyms back to original values.
reverse-map.json
!examples/**/reverse-map.json.absent

# Local configuration, which will name real hosts.
config/local*.yaml
config/*.local.yaml
*.local.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
